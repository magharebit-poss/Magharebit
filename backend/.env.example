# GreenGo backend — example environment configuration.
# Copy to `.env` and fill in real values. NEVER commit a real .env or real secrets.

# ── Required — server will not start without these ──
# PostgreSQL connection string (used by src/index.ts pg.Pool).
DATABASE_URL=postgresql://greengo:CHANGE_ME@localhost:5432/greengo_dev
# HS256 signing secret for all JWTs. Boot guard: server refuses to start if unset.
JWT_SECRET=replace-with-32-plus-random-chars
# The merchant's license key. Boot gate: server refuses to start if unset OR if
# validation returns valid=false. Issued by the website backend (MGHB- format).
LICENSE_KEY=MGHB-XXXX-XXXX-XXXX-XXXX

# ── Required in production only ──
# Single allowed browser CORS origin (e.g. the pos-web/admin host).
# Boot guard: in production (NODE_ENV=production) the server refuses to start if unset.
# In development this is ignored and http://localhost:3003 is used automatically.
CORS_ORIGIN=https://app.example.com

# ── Optional — defaults shown ──
PORT=3001                 # HTTP listen port (default 3001)
HOST=0.0.0.0              # HTTP bind address (default 0.0.0.0)
NODE_ENV=development      # development | staging | production (default development)
LOG_LEVEL=info            # pino log level (default info)

# ── Dev-only license bypass (NEVER set in production) ──
# Set to 'true' to skip license validation at boot.
# The server refuses to start if this is 'true' AND NODE_ENV=production.
LICENSE_BYPASS_DEV=false

# ── Monitoring (optional in development) ──
# Sentry DSN for the backend. Optional in dev; required in production IF Sentry init
# is invoked (initSentryBackend throws in production when unset).
SENTRY_DSN_BACKEND=https://examplePublicKey@o0.ingest.sentry.io/0
# Grafana Loki push endpoint for log shipping (optional; logging works without it).
LOKI_ENDPOINT=http://localhost:3100

# ── App version (served by GET /app/version) ──
# All three are required for GET /app/version to return 200 (else 503).
APP_LATEST_VERSION=1.0.0
APP_MIN_REQUIRED_VERSION=1.0.0
APP_DOWNLOAD_URL=https://app.example.com/download

# ── AWS S3 (portal APK distribution — optional) ──
# Bucket name read by the portal APK download-url route (src/api/portal/portal-routes.ts).
# If unset, the portal falls back to APP_DOWNLOAD_URL instead of a presigned URL.
S3_BUCKET=greengo-apk-dist
AWS_REGION=eu-west-1
# AWS credentials are NOT read directly by app code — they are consumed by the AWS SDK's
# default credential provider chain when generating S3 presigned URLs. Set these (or use
# an IAM role / shared credentials file) only if S3 presigning is enabled.
AWS_ACCESS_KEY_ID=replace-with-aws-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-access-key

# ── License validation (required) ──
# Remote endpoint that validates LICENSE_KEY (website backend). Boot gate calls this.
LICENSE_VALIDATOR_URL=https://magharebit.ma/api/licenses/validate
# Shared x-api-key secret for the validator. NEVER commit the real value.
LICENSE_VALIDATOR_KEY=replace-with-shared-api-key
# Stable install id. Auto-generated on first run into backend/data/device-id.json
# (gitignored). Set this only as a fallback where filesystem persistence isn't viable.
LICENSE_DEVICE_ID=  # auto-generated on first run if blank
# Hours a cached validation result is considered fresh (no network call). Default 24.
LICENSE_CACHE_TTL_HOURS=24
# Hours the POS keeps operating on a stale cache when the validator is unreachable
# before blocking. Default 168 (7 days).
LICENSE_GRACE_HOURS=168

# ── Returns threshold ──
# Minimum return total (in piastres) that requires manager approval.
# 5000 piastres = 50.00 MAD (default). Must match NEXT_PUBLIC_RETURN_THRESHOLD_PIASTRES in pos-web.
RETURN_THRESHOLD_PIASTRES=5000

# ── Lana Cash payment webhook ──
# HMAC-SHA256 secret provided by Lana Cash. Used to validate incoming webhook
# signatures (X-Lana-Signature: sha256=<hex>). NEVER commit the real value.
# The webhook handler returns 500 if this variable is absent at runtime.
LANA_WEBHOOK_SECRET=replace-with-lana-provided-secret

# ── PIN hashing (Argon2id) ──
# No env configuration required. Fixed params (src/services/pin-hash.ts):
# Argon2id, memoryCost=65536 (64 MiB), timeCost=3, parallelism=1.
# Legacy SHA-256 hashes are transparently upgraded on next successful login.

# ── License signing (admin license generator only) ──
# HMAC secret used by POST /admin/licenses/generate (src/api/admin/admin-routes.ts).
# Do NOT set on a plain POS backend unless you intentionally run the key generator.
MASTER_SIGNING_SECRET=replace-with-32-plus-random-chars

# ── WhatsApp daily digest (Green API) ────────────────────────────────────────
# Provider: 'green-api' (default). To swap to Meta Cloud API, create
# meta-cloud-api.ts implementing WhatsAppProvider and set this to 'meta-cloud-api'.
WHATSAPP_PROVIDER=green-api

# Green API credentials — obtain from https://console.green-api.com
# Both required for sending. If either is absent the backend logs a warning
# and skips sending (does NOT crash).
GREENAPI_INSTANCE_ID=replace-with-instance-id
GREENAPI_API_TOKEN=replace-with-api-token
# Webhook token — sent by Green API in ?token= query param on incoming webhooks.
# Unset = dev mode (accepts without verification). Set in production.
GREENAPI_WEBHOOK_TOKEN=replace-with-webhook-token

# Anomaly threshold: discounts and returns above this amount (piastres) are
# flagged in the digest. Default 5000 piastres = 50.00 MAD.
DIGEST_ANOMALY_THRESHOLD_PIASTRES=5000

# ── Per-tenant integration credentials (Settings > Integrations) ───────────────
# 32 random bytes, base64. Encrypts each tenant's AI key and Green API token at rest
# (AES-256-GCM). No fallback key exists: without it, saving a secret is refused.
# Generate one locally and paste it here; NEVER share it or commit it:
#   openssl rand -base64 32
# Losing or changing this key makes stored tenant credentials unreadable.
CREDENTIALS_ENCRYPTION_KEY=

# ── Image storage ─────────────────────────────────────────────────────────────
# Provider: 'local' (default) writes to disk. Future: 's3'.
STORAGE_PROVIDER=local
# Absolute or relative path to the images directory (relative = from backend/).
# 'data/' is already gitignored in backend/.gitignore.
IMAGES_DIR=./data/images
# Public base URL for serving images (the /images/ static route).
IMAGES_BASE_URL=http://localhost:3001/images

# ── Cashier integrity thresholds (all optional — defaults shown) ──────────────
# Max void rate before flagging (fraction of total transactions). Default 5%.
INTEGRITY_VOID_RATE_MAX=0.05
# Max large-discount rate before flagging. Default 10%.
INTEGRITY_DISCOUNT_RATE_MAX=0.10
# Max large-return rate before flagging. Default 5%.
INTEGRITY_RETURN_RATE_MAX=0.05
# Min average seconds per transaction before flagging (unusually fast). Default 30s.
INTEGRITY_TX_SECONDS_MIN=30
# Max cash share before flagging (high all-cash ratio). Default 95%.
INTEGRITY_CASH_SHARE_MAX=0.95
# Max absolute average cash discrepancy (piastres) before flagging. Default 5000 (50 MAD).
INTEGRITY_CASH_DISCREPANCY_MAX=5000
# Discount amount above which a single transaction counts as a "large discount" (piastres).
INTEGRITY_DISCOUNT_THRESHOLD_PIASTRES=5000

# ── ClickHouse Analytics ─────────────────────────────────────────────────────
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=magharebit_analytics
CLICKHOUSE_USER=magharebit
CLICKHOUSE_PASSWORD=change-me
  # Must equal CLICKHOUSE_PASSWORD in infra/.env (see infra/.env.example). Never commit the real value.

# ── Invoice OCR ──────────────────────────────────
# Provider: 'google' (default) or 'tesseract'
# google requires GOOGLE_VISION_CREDENTIALS_JSON
#   or GOOGLE_APPLICATION_CREDENTIALS
# tesseract requires the tesseract binary installed on the OS (ara+fra langdata)
INVOICE_OCR_PROVIDER=google

# Google Cloud Vision service account JSON
# (paste the full JSON as a single line, or use GOOGLE_APPLICATION_CREDENTIALS
#  to point to a file path instead)
# GOOGLE_VISION_CREDENTIALS_JSON={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
