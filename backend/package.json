{
  "name": "@greengo/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "tsx scripts/run-migrations.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "tsx scripts/run-migrations.ts && tsx scripts/seed.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "etl": "tsx src/scripts/run-etl.ts",
    "etl:dry": "tsx src/scripts/run-etl.ts --dry-run",
    "ml": "tsx src/scripts/run-ml.ts",
    "ml:dry": "tsx src/scripts/run-ml.ts --dry-run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@clickhouse/client": "^1.24.1",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.2.0",
    "@fastify/static": "^9.1.3",
    "@google-cloud/vision": "^5.3.7",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@sentry/node": "^8.40.0",
    "argon2": "^0.44.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.1.0",
    "node-cron": "^3.0.3",
    "node-tesseract-ocr": "^2.2.1",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.0",
    "@types/sharp": "^0.31.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
