# Local development secrets for infra/docker-compose.yml.
#
#   Copy this file to infra/.env (git-ignored) and fill in every value.
#   docker compose refuses to start while any of them is empty.
#   NEVER commit infra/.env.
#
# POSTGRES_PASSWORD and CLICKHOUSE_PASSWORD are applied only when their data volume is first created.
# For a database that already exists, use the password it was created with: changing it here later
# does not change the stored one, and pgbouncer would then fail to log in.
#
# POSTGRES_PASSWORD must match the password inside DATABASE_URL in backend/.env.

POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
