# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# Real env files stay ignored; only the placeholder template is tracked.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local runtime data: merchant leads, callbacks and license records (PII / keys)
# top-level data/*.json only; data/posts/ (blog content) stays tracked
/data/*.json

# Large AI draft renders (review only; optimised assets live in public/media)
docs/phase2-drafts/
/.next-*/

# local-only admin sign-in reference (contains the local dev password): never commit
/local-credentials.md
