# MAGHAREBIT web: environment template. Copy to .env.local (git-ignored) and fill in.
# This file is tracked: it must contain placeholders only, never real values.
#
# Local QA: see docs/local-setup.md. Deployment: see DEPLOY.md.

# ─── REQUIRED, SERVER-ONLY (never give these a NEXT_PUBLIC_ prefix) ──────────
# Admin password for /ar/admin/*, also the x-admin-secret value for admin API scripts.
# Left empty on purpose: admin login fails closed (503) until you set a strong random value.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=

# Signs sessions (admin cookie, portal, OTP), license keys and employee PIN hashes.
# REQUIRED. Admin login returns 503 without it. Use a random 64-hex value, never a
# placeholder. Changing it later invalidates existing sessions, license keys and PINs.
NEXTAUTH_SECRET=
# Not read by the current code (no NextAuth in use); kept for a future auth provider.
NEXTAUTH_URL=https://magharebit.com

# MongoDB (Atlas or local). Fill in from your secrets store.
# The /magharebit segment before the ? is the DATABASE NAME; without it the driver uses `test`.
# OTP, sign-up, login and the merchant portal have NO fallback and return 503 without a database.
MONGODB_URI=mongodb+srv://<DB_USER>:<PASSWORD>@<cluster-host>/magharebit?appName=magharebit&retryWrites=true&w=majority
MONGODB_DB=magharebit

# ─── REMOVED / DEPRECATED: delete from EVERY environment ─────────────────────
# NEXT_PUBLIC_ADMIN_PASSWORD   REMOVED. Variables with a NEXT_PUBLIC_ prefix are embedded in the
#                              browser bundle, so this one exposed the admin secret to every
#                              visitor. The code no longer reads it. Delete it from .env.local,
#                              the hosting dashboard (Vercel) and CI. If an old deployment used
#                              it, treat that ADMIN_SECRET value as compromised and rotate it.
# NEXT_PUBLIC_SITE_URL         NOT READ by the code. Use NEXT_PUBLIC_BASE_URL.

# ─── Public (exposed to the browser: no secrets here) ────────────────────────
# Canonical site URL (used by sitemap + robots). Local dev: http://localhost:3004
NEXT_PUBLIC_BASE_URL=https://magharebit.com
# App URL used in WhatsApp notification templates
NEXT_PUBLIC_APP_URL=https://magharebit.com

# Optional marketing endpoint: /api/demo-request forwards to <url>/marketing/demo-request
# (fire-and-forget). Leave UNSET for local QA so test data is not posted anywhere.
NEXT_PUBLIC_API_URL=https://api.magharebit.com

# Demo video (YouTube/Vimeo embed URL; empty shows a placeholder)
NEXT_PUBLIC_DEMO_VIDEO_URL=
# App download links (empty shows a "coming soon" badge)
NEXT_PUBLIC_DOWNLOAD_WINDOWS_URL=
NEXT_PUBLIC_DOWNLOAD_ANDROID_URL=

# ─── Optional integrations (server-only) ─────────────────────────────────────
# Email OTP (Resend). Unset in development: the OTP is printed to the server console.
# EMAIL_FROM is used only when RESEND_API_KEY is set; the sender domain must be verified.
RESEND_API_KEY=
EMAIL_FROM=MAGHAREBIT <contact@magharebit.com>

# WhatsApp Business API (Green API, greenapi.com): WhatsApp OTP, lead and license messages
GREEN_API_BASE_URL=https://api.green-api.com
GREEN_API_INSTANCE_ID=
GREEN_API_API_TOKEN=
WHATSAPP_BUSINESS_NUMBER=212619522487

# Twilio (SMS OTP fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Protects /api/cron/daily-report
CRON_SECRET=
