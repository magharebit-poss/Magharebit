# GreenGo pos-web — example environment configuration.
# Copy to `.env.local` and adjust. NEVER commit real values.

# ── Required ──
# Base URL of the GreenGo backend API. The Next.js /api/* proxy routes forward
# requests here (default http://localhost:3001 if unset).
NEXT_PUBLIC_API_URL=http://localhost:3001
# Backend URL used when running inside Tauri (direct calls, bypassing the
# Next.js proxy). In browser dev mode this is unused. Default http://localhost:3001.
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
# Tenant UUID for this install. Sent as ?tenantId on the pre-auth cashier-list
# call so the login screen only shows THIS merchant's staff. Required — the
# login screen cannot load the cashier list without it.
NEXT_PUBLIC_TENANT_ID=00000000-0000-0000-0000-000000000000

# ── Support contact shown on the license-error screen ──
# Placeholder shown when the backend reports the license is invalid/expired.
NEXT_PUBLIC_SUPPORT_CONTACT=contact@magharebit.com

# ── Merchant branding fallbacks (used until the license validation response
#    supplies these). The merchant's own business identity shown on receipts.
#    Not secret. The merchant NAME comes from the license response; these cover
#    fields the license response does not yet provide. Leave blank to omit.
NEXT_PUBLIC_MERCHANT_ADDRESS=
NEXT_PUBLIC_MERCHANT_PHONE=
NEXT_PUBLIC_MERCHANT_TAX_ID=
NEXT_PUBLIC_MERCHANT_LOGO_URL=

# ── Merchant fiscal identifiers (DGI required on TVA-compliant invoices) ──
# These appear on formal invoices (Facture) generated via the invoice flow.
# Not secret — they are printed on customer-facing documents. Put the merchant's OWN values in
# .env.local, never real ones in this template.
NEXT_PUBLIC_MERCHANT_ICE=000000000000000
NEXT_PUBLIC_MERCHANT_IF=00000000
NEXT_PUBLIC_MERCHANT_RC=00000

# ── Card payment terminal configuration ──────────────────────────────────────
# Timeout in seconds waiting for the customer to present their card.
# The countdown UI in CardPaymentModal counts from this value. Default: 60.
NEXT_PUBLIC_CARD_TIMEOUT_SECONDS=60
#
# Terminal connection parameters (used by the Tauri Rust module — not needed in
# browser dev mode). These will be fully documented when the CMI integration
# spec is received. Uncomment and configure per installation.
# CARD_TERMINAL_PORT=COM3
# CARD_TERMINAL_BAUD=9600

# ── Lana Cash payment configuration ─────────────────────────────────────────
# QR code display timeout in seconds. The countdown in LanaPaymentModal counts
# from this value. Default: 180 (3 minutes — matches the backend session TTL).
NEXT_PUBLIC_LANA_TIMEOUT_SECONDS=180

# ── Returns configuration ─────────────────────────────────────────────────────
# Refund amounts ABOVE this (piastres; 5000 = 50.00 MAD) require a manager PIN.
# Freeform (no-receipt) returns ALWAYS require a manager PIN regardless of amount.
NEXT_PUBLIC_RETURN_THRESHOLD_PIASTRES=5000

# ── Stock visibility ─────────────────────────────────────────────────────────
# Global low-stock threshold (units / grams for weighted products).
# Products with stock_quantity at or below this value show an amber low-stock
# warning on their card and appear in the manager's stock-alert panel.
# Per-product low_stock_threshold overrides this when it is higher.
# Only applies to products with track_stock = true.
NEXT_PUBLIC_LOW_STOCK_THRESHOLD=5

# ── Kitchen Display System (KDS) ─────────────────────────────────────────────
# Enable the "Send to kitchen" button in the POS cart area, and the KDS send
# button in the WhatsApp orders panel. Set to true for cafes and restaurants.
# Leave false for retail merchants that have no kitchen display.
NEXT_PUBLIC_KDS_ENABLED=false

# ── Manual discount manager-approval thresholds ──
# Percentage discounts ABOVE this (percent) require a manager PIN. Default 20.
NEXT_PUBLIC_DISCOUNT_PCT_THRESHOLD=20
# Fixed discounts ABOVE this (in piastres; 5000 = 50.00 MAD) require a manager
# PIN. Default 5000.
NEXT_PUBLIC_DISCOUNT_FIXED_THRESHOLD_PIASTRES=5000

# ── Weighing scale integration ───────────────────────────────────────────────
# Enable the scale setup + weight-read (⚖) button in the POS.
# Set true for merchants with a weighing scale (butcher, grocery, produce).
# Leave false for merchants that ring weighted items manually.
NEXT_PUBLIC_SCALE_ENABLED=false

# ── Invoice OCR ──────────────────────────────────────────────────────────────
# Enable the invoice OCR scan button in /suppliers receiving.
# Set true when OCR is configured on the backend (INVOICE_OCR_PROVIDER).
NEXT_PUBLIC_OCR_ENABLED=false
