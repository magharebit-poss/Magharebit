{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "build:tauri": {
      "dependsOn": ["^build:tauri"],
      "outputs": ["src-tauri/target/**", "out/**"],
      "env": ["TAURI_BUILD", "NEXT_PUBLIC_BACKEND_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"]
    },
    "lint": {}
  }
}
