{
  "name": "greengo-pos",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/web",
    "apps/admin",
    "apps/pos-web",
    "apps/magharebit-web",
    "backend"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@greengo/web",
    "dev:admin": "turbo run dev --filter=@greengo/admin",
    "dev:pos-web": "turbo run dev --filter=@greengo/pos-web",
    "dev:backend": "turbo run dev --filter=@greengo/backend",
    "dev:magharebit": "npm run dev --workspace=apps/magharebit-web",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:migrate": "npm run db:migrate --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "db:setup": "npm run db:setup --workspace=backend",
    "docker:up": "docker-compose -f infra/docker-compose.yml up -d postgres pgbouncer",
    "docker:down": "docker-compose -f infra/docker-compose.yml down"
  },
  "packageManager": "npm@10.8.1",
  "devDependencies": {
    "@react-native/gradle-plugin": "^0.76.6",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  }
}
